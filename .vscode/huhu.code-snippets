{
	"HPC Benchmark Skeleton": {
		"scope": "cpp,c",
		"prefix": "hpc-skeleton",
		"body": [
			"#include <iostream>",
			"#include <vector>",
			"#include <chrono>",
			"#include <cstdlib>",
			"#include <immintrin.h>",
			"#include <omp.h>",
			"",
			"// Đảm bảo dữ liệu căn lề 64 bytes (Cache Line Boundary)",
			"template <typename T>",
			"T* allocate_aligned(size_t count, size_t alignment = 64) {",
			"    return static_cast<T*>(aligned_alloc(alignment, count * sizeof(T)));",
			"}",
			"",
			"int main(int argc, char** argv) {",
			"    const size_t N = ${1:10000000ULL};",
			"    const int iterations = ${2:10};",
			"    const int num_threads = omp_get_max_threads();",
			"",
			"    std::cout << \"[HPC Benchmark] Threads: \" << num_threads << \" | Problem Size N: \" << N << std::endl;",
			"",
			"    ${3:// 1. Setup Data}",
			"    float* a = allocate_aligned<float>(N);",
			"    float* b = allocate_aligned<float>(N);",
			"",
			"    #pragma omp parallel for schedule(static)",
			"    for (size_t i = 0; i < N; ++i) {",
			"        a[i] = 1.0f;",
			"        b[i] = 2.0f;",
			"    }",
			"",
			"    // Warm-up cache",
			"    ${4:// warm-up call}",
			"",
			"    // Đo đạc thời gian chạy (Wall-clock time)",
			"    double start_time = omp_get_wtime();",
			"    for (int iter = 0; iter < iterations; ++iter) {",
			"        $0",
			"    }",
			"    double elapsed_time = (omp_get_wtime() - start_time) / iterations;",
			"",
			"    // Tính toán Throughput và GFLOPS",
			"    double total_flops = static_cast<double>(N) * ${5:2.0}; // Điều chỉnh số FLOPs/phần tử",
			"    double gflops = (total_flops / elapsed_time) / 1e9;",
			"    double bytes_transferred = static_cast<double>(N) * ${6:2.0} * sizeof(float); // Bytes DRAM traffic",
			"    double bandwidth_gbs = (bytes_transferred / elapsed_time) / 1e9;",
			"",
			"    std::cout << \"Elapsed Time: \" << elapsed_time * 1e3 << \" ms\" << std::endl;",
			"    std::cout << \"Throughput:   \" << gflops << \" GFLOPS\" << std::endl;",
			"    std::cout << \"Bandwidth:    \" << bandwidth_gbs << \" GB/s\" << std::endl;",
			"",
			"    free(a);",
			"    free(b);",
			"    return 0;",
			"}"
		],
		"description": "Tạo khung chương trình C++ đo benchmark hoàn chỉnh cho HPC (FLOPs, Bandwidth, OpenMP)"
	},

