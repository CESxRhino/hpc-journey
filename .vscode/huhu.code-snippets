	"AVX2 256-bit FMA Loop": {
		"scope": "cpp,c",
		"prefix": "hpc-avx-fma",
		"body": [
			"__m256 ${1:va} = _mm256_loadu_ps(&${2:a}[i]);",
			"__m256 ${3:vb} = _mm256_loadu_ps(&${4:b}[i]);",
			"__m256 ${5:vc} = _mm256_loadu_ps(&${6:c}[i]);",
			"${5:vc} = _mm256_fmadd_ps(${1:va}, ${3:vb}, ${5:vc});",
			"_mm256_storeu_ps(&${6:c}[i], ${5:vc});"
		],
		"description": "Thực hiện lệnh vector FMA (Fused Multiply-Add: c = a * b + c) 8 phần tử float 32-bit"
	},

